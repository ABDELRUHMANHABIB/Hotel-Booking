{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/rooms",
      "destination": "/index.html"
    },
    {
      "source": "/rooms/:roomId",
      "destination": "/index.html"
    },
    {
      "source": "/offers/:offerId",
      "destination": "/index.html"
    },
    {
      "source": "/booking/:result",
      "destination": "/index.html"
    },
    {
      "source": "/owner",
      "destination": "/index.html"
    }
  ]
}
